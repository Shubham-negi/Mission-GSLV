    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "When two angles having the same vertex and one common arm but the arms
    which are not common are making a straight line then these are called the linear
    pair of angles. \rHere \u2220Q  and \u2220R are linear pair of angles."
